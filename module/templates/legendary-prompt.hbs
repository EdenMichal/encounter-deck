<div class="ed-legendary-prompt" {{#unless prompt}}hidden{{/unless}}>
  {{#if prompt}}
  <button type="button" class="ed-lp-close" data-action="edDismissPrompt" data-tooltip="Close until the next turn" aria-label="Close the Legendary Prompt"><i class="fa-solid fa-xmark" inert></i></button>
  {{#each prompt.rows}}
  <div class="ed-lp-row" data-combatant-id="{{id}}">
    <span class="ed-lp-who">
      <i class="fa-solid fa-crown ed-lp-icon" inert></i>
      <span class="ed-lp-name">{{name}}</span>
      <span class="ed-lp-pips" aria-label="{{legendary.value}} of {{legendary.max}} legendary actions left">{{#each pips}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>
    </span>
    <span class="ed-lp-actions">
      {{#each actions}}
      <button type="button" data-action="edLegendary" data-combatant-id="{{../id}}" data-item-id="{{itemId}}" data-activity-id="{{activityId}}"
        {{#unless usable}}disabled data-tooltip="Costs {{cost}}: not enough left"{{/unless}}>
        {{name}}{{#if showCost}} <span class="ed-lp-cost">·{{cost}}</span>{{/if}}
      </button>
      {{else}}
      <span class="ed-lp-none">No legendary actions on its sheet</span>
      {{/each}}
    </span>
  </div>
  {{/each}}
  {{#if prompt.recharge}}
  <div class="ed-lp-row ed-lp-recharge">
    <span class="ed-lp-who"><i class="fa-solid fa-bolt ed-lp-icon" inert></i><span class="ed-lp-name">{{prompt.recharge.name}}</span></span>
    <span class="ed-lp-actions">
      {{#each prompt.recharge.abilities}}
      <span class="ed-lp-ability {{#if ready}}ready{{else}}spent{{/if}}" data-tooltip="{{#if ready}}Ready{{else}}Spent: recharges on {{label}}{{/if}}">{{name}} <span class="ed-lp-cost">{{label}}</span></span>
      {{/each}}
      {{#unless prompt.autoRecharge}}<span class="ed-lp-none" data-tooltip="dnd5e's Auto-recharge setting is off: roll it yourself">roll recharge yourself</span>{{/unless}}
    </span>
  </div>
  {{/if}}
  {{/if}}
</div>
