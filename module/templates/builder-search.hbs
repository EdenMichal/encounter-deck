<section class="ed-search">
  <div class="ed-search-name">
    <input type="search" name="edName" value="{{filter.name}}" placeholder="Search monsters" aria-label="Search monsters">
  </div>
  <div class="ed-search-grid">
    <label>CR
      <span class="ed-cr-range">
        <select name="edCrMin" aria-label="Minimum CR"><option value="">min</option>{{#each crMin}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <span>–</span>
        <select name="edCrMax" aria-label="Maximum CR"><option value="">max</option>{{#each crMax}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </span>
    </label>
    <label>Type
      <select name="edType"><option value="">Any</option>{{#each types}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label>Size
      <select name="edSize"><option value="">Any</option>{{#each sizes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label>Habitat
      <select name="edHabitat"><option value="">Any</option>{{#each habitats}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
  </div>
  <div class="ed-search-foot">
    <button type="button" class="ed-link-button" data-action="edSources" data-tooltip="The world-wide checklist of compendiums to search (shared with dnd5e's Compendium Browser)">
      <i class="fa-solid fa-book-open-reader" inert></i> Sources ({{sourceCount}})
    </button>
    <button type="button" class="ed-link-button ed-clear-filters" data-action="edClearFilters" {{#unless filtered}}hidden{{/unless}}>Clear filters</button>
  </div>
</section>
