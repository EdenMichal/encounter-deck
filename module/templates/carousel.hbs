<div class="ed-car-strip">
  {{#if show}}
  {{#if isGM}}
  <button type="button" class="ed-car-nav" data-action="edPrevTurn" data-tooltip="Previous turn" aria-label="Previous turn"><i class="fa-solid fa-chevron-left" inert></i></button>
  {{/if}}
  <div class="ed-car-round" aria-label="Round {{round}}"><i class="fa-solid fa-chevron-right" inert></i><span>{{round}}</span></div>
  <ol class="ed-car-list">
    {{#each cards}}
    <li class="ed-car-item {{#if current}}current{{/if}} {{#if hero}}hero{{/if}} {{#if defeated}}defeated{{/if}} {{#if secret}}secret{{/if}}" data-combatant-id="{{id}}">
      <div class="ed-car-card" data-action="edCard" data-tooltip="{{name}}" aria-label="{{name}}">
        <img class="ed-car-portrait" src="{{img}}" alt="">
        {{#if bloodied}}<span class="ed-car-bloodied" role="img" aria-label="Bloodied"></span>{{/if}}
        {{#if defeated}}<span class="ed-car-dead"><img src="{{@root.deadIcon}}" alt="Defeated"></span>{{/if}}
        {{#if init}}<span class="ed-car-init" aria-label="Initiative {{init}}">{{init}}</span>{{/if}}
        {{#if ac}}<span class="ed-car-ac" aria-label="Armor Class {{ac}}"><i class="fa-solid fa-shield" inert></i>{{ac}}</span>{{/if}}
        {{#if statuses.length}}
        <ul class="ed-car-statuses">
          {{#each statuses}}<li data-tooltip="{{name}}"><img class="{{#if svg}}svg{{/if}}" src="{{img}}" alt="{{name}}"></li>{{/each}}
          {{#if more}}<li><button type="button" class="ed-car-more" data-action="edMoreStatuses" data-tooltip="Show all statuses" aria-label="Show all {{allStatuses.length}} statuses">+{{more}}</button></li>{{/if}}
        </ul>
        {{/if}}
        {{#if current}}<span class="ed-car-name">{{name}}</span>{{/if}}
        {{#if hp}}<span class="ed-car-bar"><span class="{{#if hp.low}}low{{/if}}" style="width: {{hp.pct}}%"></span></span>{{/if}}
      </div>
      {{#if hero}}<div class="ed-car-trim"><img src="{{@root.trim}}" alt=""></div>{{/if}}
      {{#if hp}}<span class="ed-car-hp">{{hp.text}}</span>{{/if}}
      {{#if (or legendary resistance)}}
      <div class="ed-car-legend" aria-label="Legendary actions and resistances left: hover for the Legendary Menu">
        {{#if legendary}}<span class="ed-car-legendary" role="img" aria-label="Legendary actions left">{{#each legendary}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>{{/if}}
        {{#if resistance}}<span class="ed-car-resistance" role="img" aria-label="Legendary resistances left">{{#each resistance}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>{{/if}}
      </div>
      {{/if}}
    </li>
    {{/each}}
  </ol>
  {{#if popover}}
  <div class="ed-car-popover" data-for="{{popover.id}}" role="dialog" aria-label="Statuses of {{popover.name}}">
    <h3>{{popover.name}}</h3>
    <ul>
      {{#each popover.statuses}}<li><img class="{{#if svg}}svg{{/if}}" src="{{img}}" alt=""><span>{{name}}</span></li>{{/each}}
    </ul>
  </div>
  {{/if}}
  {{#if legend}}
  <div class="ed-car-lm" data-for="{{legend.id}}" role="dialog" aria-label="Legendary Menu of {{legend.name}}">
    <h3><i class="fa-solid fa-crown" inert></i> {{legend.name}}</h3>
    {{#if legend.legendary}}
    <div class="ed-lm-line">
      <span class="ed-lm-label">Legendary actions</span>
      <span class="ed-lm-pips">{{#each legend.pips}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>
      <span class="ed-lm-count">{{legend.legendary.value}}/{{legend.legendary.max}}</span>
    </div>
    <div class="ed-lm-actions">
      {{#each legend.actions}}
      <button type="button" data-action="edLegendary" data-combatant-id="{{@root.legend.id}}" data-item-id="{{itemId}}" data-activity-id="{{activityId}}"
        class="{{#unless usable}}ed-lm-spent{{/unless}}" {{#unless usable}}aria-disabled="true"{{/unless}}
        {{#if uuid}}data-tooltip='<section class="loading" data-uuid="{{uuid}}"><i class="fas fa-spinner fa-spin-pulse"></i></section>'
        data-tooltip-class="dnd5e2 dnd5e-tooltip item-tooltip themed theme-light"{{/if}}>
        <img src="{{img}}" alt=""><span>{{name}}</span>{{#if showCost}}<span class="ed-lm-cost">{{cost}}</span>{{/if}}
      </button>
      {{else}}
      <span class="ed-lm-none">No legendary actions on its sheet</span>
      {{/each}}
    </div>
    {{#if legend.ownTurn}}<p class="ed-lm-none">It's its own turn: legendary actions come at the end of another creature's turn.</p>{{/if}}
    {{/if}}
    {{#if legend.resistance}}
    <div class="ed-lm-line">
      <span class="ed-lm-label">Legendary resistance</span>
      <span class="ed-lm-shields">{{#each legend.shields}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>
      <span class="ed-lm-count">{{legend.resistance.value}}/{{legend.resistance.max}}</span>
    </div>
    {{/if}}
    {{#if legend.recharge.length}}
    <div class="ed-lm-line ed-lm-recharge">
      <span class="ed-lm-label"><i class="fa-solid fa-bolt" inert></i> Recharge</span>
    </div>
    <div class="ed-lm-abilities">
      {{#each legend.recharge}}
      <span class="ed-lm-ability {{#if ready}}ready{{else}}spent{{/if}}">{{name}} <span class="ed-lm-cost">{{label}}</span> <span class="ed-lm-state">{{#if ready}}ready{{else}}spent{{/if}}</span></span>
      {{/each}}
      {{#unless legend.autoRecharge}}<span class="ed-lm-none">dnd5e's Auto-recharge is off: roll recharge yourself</span>{{/unless}}
    </div>
    {{/if}}
  </div>
  {{/if}}
  {{#if isGM}}
  <button type="button" class="ed-car-nav next" data-action="edNextTurn" data-tooltip="Next turn" aria-label="Next turn"><i class="fa-solid fa-chevron-right" inert></i></button>
  {{/if}}
  {{/if}}
</div>
